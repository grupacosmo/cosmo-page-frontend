# Never commit real values.
#   - Local dev (`pnpm dev`):        copy to .env.local
#   - Docker (`docker compose up`):  copy to .env (optional — sensible defaults are used)
# COSMO_* variables are read on the server only and are never sent to the browser.

# Base URL of the Cosmo backend API (no trailing slash). Leave unset to use the defaults:
#   pnpm dev → http://localhost:8080, docker compose → http://host.docker.internal:8080
# COSMO_API_URL=http://localhost:8080

# API key sent to the backend in the `apiKey` header.
COSMO_API_KEY=replace-me

# Host port the frontend is published on by docker compose (default 3000).
# FRONTEND_PORT=3000
